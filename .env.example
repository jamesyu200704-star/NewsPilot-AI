# 默认使用浏览器本地 Mock，不需要后端或 API Key。
# 前端只允许出现非敏感开关：mock = 浏览器本地 Mock；local-ai = 调用 /api/generate。
VITE_GENERATION_MODE=mock
VITE_API_PROXY_TARGET=http://127.0.0.1:8787
VITE_API_TIMEOUT_MS=120000

# 以下变量仅供 Generator Service 在服务端读取。
GENERATION_MODE=mock
SERVER_HOST=127.0.0.1
SERVER_PORT=8787

# 本地 Ollama 配置。模型名称可替换为本机已安装且支持结构化输出的模型。
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_MS=90000

# 真实密钥只能写入未提交的 .env.local 或部署平台服务端 Secret。
# 绝对不要创建 VITE_OPENAI_API_KEY；VITE_ 前缀变量会进入浏览器构建。
# 公网部署必须在服务外层配置 HTTPS、身份验证、限流和成本保护网关。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_TIMEOUT_MS=30000
