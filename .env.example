# 默认使用浏览器本地 Mock，不需要后端或 API Key。
# 前端只允许出现非敏感开关：mock = 生产构建不探测后端，使用浏览器本地 Mock；
# local-ai = 探测项目后端并调用 /api/generate；后端可配置 qwen、ollama 或 openai。
VITE_GENERATION_MODE=mock
VITE_API_PROXY_TARGET=http://127.0.0.1:8787
VITE_API_TIMEOUT_MS=360000
# 纯前端公开演示设为 mock；本地完整模式设为 live，由浏览器调用受控后端。
VITE_EVIDENCE_MODE=mock
# 本地用户研究工具。公开 Demo 必须保持 false；启用后仍只写入当前浏览器，不上传外部服务。
VITE_RESEARCH_MODE=false

# 以下变量仅供 Generator Service 在服务端读取。
GENERATION_MODE=mock
SERVER_HOST=127.0.0.1
SERVER_PORT=8787

# P1 Search Provider。manual 不联网；mock 只给明确标记的演示卡；searxng 连接自托管服务。
SEARCH_PROVIDER=manual
SEARXNG_BASE_URL=http://localhost:8080
SEARCH_RESULT_LIMIT=10
SEARCH_TIMEOUT_MS=10000
SEARCH_RATE_LIMIT_PER_MINUTE=10
SEARCH_MAX_CONCURRENT_FETCHES=3

# 浏览器本地材料解析限制。VITE_ 值会进入公开构建，只能放非敏感数字配置。
VITE_UPLOAD_MAX_FILE_MB=10
VITE_UPLOAD_MAX_PROJECT_MB=50
# 服务端保留同名限制，供未来受控上传接口复用。
UPLOAD_MAX_FILE_MB=10
UPLOAD_MAX_PROJECT_MB=50

# P2 转写默认关闭自动服务，只提供人工粘贴 / TXT / Markdown。
# local_whisper 仅用于本机完整模式；音频只发送到回环地址，不上传云端。
TRANSCRIPTION_PROVIDER=manual
LOCAL_WHISPER_BASE_URL=http://localhost:9000
TRANSCRIPTION_MAX_FILE_MB=100

# 旧版 Search + RAG 兼容配置；不用于 P1 证据工作台。
SEARCH_MODE=mock
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_TIMEOUT_MS=10000

# 本地 Ollama 配置。模型名称可替换为本机已安装且支持结构化输出的模型。
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_MS=300000

# 真实密钥只能写入未提交的 .env.local 或部署平台服务端 Secret。
# 绝对不要创建 VITE_OPENAI_API_KEY 或 VITE_BRAVE_SEARCH_API_KEY；VITE_ 前缀变量会进入浏览器构建。
# 公网部署必须在服务外层配置 HTTPS、身份验证、限流和成本保护网关。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_TIMEOUT_MS=30000
