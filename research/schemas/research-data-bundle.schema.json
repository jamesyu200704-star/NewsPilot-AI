{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://newspilot.example/schemas/research-data-bundle.schema.json",
  "title": "NewsPilot 匿名研究数据包",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "exportedAt", "participants", "sessions", "observations", "events", "issues"],
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "newspilot-research-bundle" },
    "schemaVersion": { "const": 2 },
    "exportedAt": { "type": "string", "format": "date-time" },
    "participants": {
      "type": "array",
      "items": { "$ref": "#/$defs/participant" }
    },
    "sessions": {
      "type": "array",
      "items": { "$ref": "#/$defs/session" }
    },
    "observations": {
      "type": "array",
      "items": { "$ref": "#/$defs/observation" }
    },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/productEvent" }
    },
    "issues": {
      "type": "array",
      "items": { "$ref": "#/$defs/productIssue" }
    }
  },
  "$defs": {
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "academicYear", "journalismExperience", "campusMediaExperience", "priorAiToolExperience", "primaryDevice", "consentConfirmed", "synthetic", "createdAt"],
      "properties": {
        "id": { "type": "string", "pattern": "^P[0-9]{3,}$" },
        "academicYear": { "enum": ["freshman", "sophomore", "junior", "senior", "graduate", "other"] },
        "journalismExperience": { "enum": ["none", "beginner", "intermediate", "experienced"] },
        "campusMediaExperience": { "type": "boolean" },
        "priorAiToolExperience": { "type": "boolean" },
        "primaryDevice": { "enum": ["desktop", "laptop", "tablet", "mobile"] },
        "consentConfirmed": { "type": "boolean" },
        "synthetic": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "participantId", "taskId", "condition", "startedAt", "taskCompleted", "majorAssistanceRequired", "observedProblems", "comments", "synthetic", "createdAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "participantId": { "type": "string", "pattern": "^P[0-9]{3,}$" },
        "taskId": { "type": "string", "minLength": 1 },
        "condition": { "enum": ["newspilot", "generic_llm", "self_planning"] },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "taskCompleted": { "type": "boolean" },
        "timeToFirstUsablePlanSeconds": { "type": "number", "minimum": 0 },
        "totalTaskTimeSeconds": { "type": "number", "minimum": 0 },
        "majorAssistanceRequired": { "type": "boolean" },
        "abandonedStep": { "type": "string" },
        "selectedStrategyId": { "type": "string" },
        "acceptedIntervieweeCount": { "type": "integer", "minimum": 0 },
        "totalSuggestedIntervieweeCount": { "type": "integer", "minimum": 0 },
        "acceptedQuestionCount": { "type": "integer", "minimum": 0 },
        "totalSuggestedQuestionCount": { "type": "integer", "minimum": 0 },
        "majorRewriteRequired": { "type": "boolean" },
        "userKnewNextStep": { "type": "boolean" },
        "userUnderstoodVerificationStatus": { "type": "boolean" },
        "usabilityRating": { "type": "number", "minimum": 1, "maximum": 5 },
        "usefulnessRating": { "type": "number", "minimum": 1, "maximum": 5 },
        "trustRating": { "type": "number", "minimum": 1, "maximum": 5 },
        "reuseIntentRating": { "type": "number", "minimum": 1, "maximum": 5 },
        "observedProblems": { "type": "array", "items": { "type": "string" } },
        "comments": { "type": "array", "items": { "type": "string" } },
        "synthetic": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sessionId", "eventType", "page", "description", "severity", "createdAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sessionId": { "type": "string", "minLength": 1 },
        "timestampSeconds": { "type": "number", "minimum": 0 },
        "eventType": { "enum": ["hesitation", "misclick", "confusion", "backtrack", "error", "request_help", "abandonment", "positive_reaction", "other"] },
        "page": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["blocking", "major", "minor", "cosmetic"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "productEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sessionId", "eventName", "page", "timestamp", "synthetic"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sessionId": { "type": "string", "minLength": 1 },
        "eventName": {
          "enum": ["project_created", "assignment_parsed", "strategy_selected", "quick_plan_viewed", "full_plan_opened", "interviewee_added", "question_edited", "evidence_added", "interview_started", "interview_completed", "quote_confirmed", "outline_created", "assignment_check_run", "export_completed", "error_shown", "help_requested"]
        },
        "page": { "type": "string", "minLength": 1 },
        "timestamp": { "type": "string", "format": "date-time" },
        "metadata": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        },
        "synthetic": { "type": "boolean" }
      }
    },
    "productIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "category", "severity", "frequency", "userImpact", "evidence", "status", "releaseBlocker", "createdAt", "updatedAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "category": { "enum": ["data_loss", "privacy", "fabrication", "false_verification", "workflow", "usability", "content_quality", "export", "mobile", "performance", "accessibility", "documentation", "other"] },
        "severity": { "enum": ["critical", "high", "medium", "low"] },
        "frequency": { "enum": ["very_common", "common", "occasional", "rare", "unknown"] },
        "userImpact": { "enum": ["blocks_completion", "major_friction", "minor_friction", "cosmetic"] },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sessionIds", "screenshots", "notes"],
          "properties": {
            "sessionIds": { "type": "array", "items": { "type": "string" } },
            "screenshots": { "type": "array", "items": { "type": "string" } },
            "notes": { "type": "array", "items": { "type": "string" } }
          }
        },
        "proposedResolution": { "type": "string" },
        "status": { "enum": ["new", "confirmed", "planned", "in_progress", "resolved", "wont_fix", "needs_more_data"] },
        "releaseBlocker": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
