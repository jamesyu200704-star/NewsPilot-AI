use_default_settings: true

general:
  debug: false
  instance_name: "NewsPilot Local Search"

search:
  safe_search: 1
  formats:
    - html
    - json

server:
  bind_address: "0.0.0.0"
  port: 8080
  limiter: false
  image_proxy: false
  # 本文件只能作为示例；运行 scripts/初始化SearXNG配置.ps1 生成本机随机值。
  secret_key: "REPLACE_WITH_GENERATED_SECRET"

ui:
  default_locale: "zh-CN"

outgoing:
  request_timeout: 5.0
  max_request_timeout: 10.0
