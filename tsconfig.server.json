{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist-server",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node"]
  },
  "include": [
    "server/**/*.ts",
    "knowledge/**/*.ts",
    "strategy-library/**/*.ts",
    "evals/**/*.ts",
    "prompts/**/*.ts",
    "rules/**/*.ts",
    "shared/**/*.ts",
    "src/services/apiGenerator.ts",
    "src/services/generationMode.ts",
    "src/services/providerStatus.ts",
    "src/services/本地项目仓库.ts",
    "src/types/index.ts",
    "src/utils/markdownExport.ts"
  ]
}
